# ShotType affiliate configuration
# Public site URL used by metadata, robots.txt, and sitemap.xml after deployment.
NEXT_PUBLIC_SITE_URL=

# Copy this file to .env.local and fill in values after each affiliate program approves your account.
#
# Do NOT put bank account numbers, card numbers, 주민등록번호, or payout credentials here.
# Payout bank accounts must be registered inside each affiliate platform's secure dashboard.
#
# Prefer the deep link template supplied by the affiliate network. Supported placeholders:
#   {url}    encoded destination URL
#   {rawUrl} unencoded destination URL
#   {query}  encoded product search query
#   {id}     encoded affiliate/publisher ID
#
# If a network only requires adding a query parameter, set both *_ID and *_QUERY_PARAM.

NEXT_PUBLIC_AFFILIATE_BH_ID=
NEXT_PUBLIC_AFFILIATE_BH_TEMPLATE=
NEXT_PUBLIC_AFFILIATE_BH_QUERY_PARAM=

NEXT_PUBLIC_AFFILIATE_KEH_ID=
NEXT_PUBLIC_AFFILIATE_KEH_TEMPLATE=
NEXT_PUBLIC_AFFILIATE_KEH_QUERY_PARAM=

NEXT_PUBLIC_AFFILIATE_MPB_ID=
NEXT_PUBLIC_AFFILIATE_MPB_TEMPLATE=
NEXT_PUBLIC_AFFILIATE_MPB_QUERY_PARAM=

NEXT_PUBLIC_AFFILIATE_NAVER_ID=
NEXT_PUBLIC_AFFILIATE_NAVER_TEMPLATE=
NEXT_PUBLIC_AFFILIATE_NAVER_QUERY_PARAM=

NEXT_PUBLIC_AFFILIATE_FREESTYLE_ID=
NEXT_PUBLIC_AFFILIATE_FREESTYLE_TEMPLATE=
NEXT_PUBLIC_AFFILIATE_FREESTYLE_QUERY_PARAM=
